# Copy to .env and fill in. Never commit .env.

# Django. Generate a key with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to true only when Spoor is served over HTTPS (enables secure cookies, HSTS, and redirects).
HTTPS=false

# Postgres. docker compose uses these to create the database.
# POSTGRES_PORT is also the host port compose publishes; change it if 5432 is taken.
POSTGRES_DB=spoor
POSTGRES_USER=spoor
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Chain data providers.
# TronGrid works without a key but is heavily rate limited; get a free key at trongrid.io.
TRONGRID_API_KEY=

# Redis. REDIS_PORT is the host port compose publishes; keep the broker URL in step with it.
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
